{
  "name": "@proj-airi/docs",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Documentation website for Project AIRI",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -F @proj-airi/vitepress-theme build && vitepress dev",
    "build": "pnpm -F @proj-airi/vitepress-theme build && vitepress build",
    "build:base": "BASE_URL=/docs/ pnpm run build",
    "preview": "vitepress preview",
    "typecheck": "vue-tsc --noEmit && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "contributors": "tsx scripts/update-contributors.ts",
    "to-avif": "tsx scripts/avif.ts",
    "release": "pnpm -F @proj-airi/vitepress-theme run release"
  },
  "dependencies": {
    "@iconify/vue": "catalog:",
    "@moeru/std": "catalog:",
    "@openpanel/web": "catalog:",
    "@proj-airi/chromatic": "catalog:",
    "@proj-airi/ui": "catalog:",
    "@proj-airi/vitepress-theme": "workspace:^",
    "@vueuse/core": "catalog:",
    "animejs": "catalog:",
    "date-fns": "catalog:",
    "motion-v": "catalog:",
    "pathe": "catalog:",
    "reka-ui": "catalog:",
    "uncrypto": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/mingcute": "catalog:",
    "@iconify-json/twemoji": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@napi-rs/image": "catalog:",
    "@types/hast": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@vue/tsconfig": "catalog:",
    "eslint": "catalog:",
    "markdown-it": "catalog:",
    "oxc-minify": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vue-tsc": "catalog:"
  }
}
